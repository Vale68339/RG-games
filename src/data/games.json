    "controls": ["Arrow Keys or WASD to change direction", "Space to pause/resume", "R to restart"],
    "iframeSource": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Snake</title><style>*{box-sizing:border-box;margin:0;padding:0;}body{background:#0f172a;color:#f8fafc;font-family:system-ui;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;overflow:hidden;}.score-box{background:#1e293b;padding:8px 16px;border-radius:8px;border:1px solid #334155;margin-bottom:10px;}canvas{background:#020617;border:2px solid #22c55e;border-radius:12px;}</style></head><body><div class='score-box'>SCORE: <span id='score' style='color:#4ade80'>0</span></div><canvas id='c' width='380' height='380'></canvas><script>const canvas=document.getElementById('c');const ctx=canvas.getContext('2d');let snake=[{x:10,y:10}],food={x:5,y:5},dx=1,dy=0,score=0;function update(){const h={x:snake[0].x+dx,y:snake[0].y+dy};if(h.x<0||h.x>=19||h.y<0||h.y>=19||snake.some(s=>s.x===h.x&&s.y===h.y)){snake=[{x:10,y:10}];dx=1;dy=0;score=0;document.getElementById('score').innerText=0;return;}snake.unshift(h);if(h.x===food.x&&h.y===food.y){score+=10;document.getElementById('score').innerText=score;food={x:Math.floor(Math.random()*19),y:Math.floor(Math.random()*19)};}else{snake.pop();}ctx.fillStyle='#020617';ctx.fillRect(0,0,380,380);ctx.fillStyle='#ef4444';ctx.beginPath();ctx.arc(food.x*20+10,food.y*20+10,8,0,Math.PI*2);ctx.fill();ctx.fillStyle='#22c55e';snake.forEach(s=>ctx.fillRect(s.x*20+1,s.y*20+1,18,18));}setInterval(update,100);window.addEventListener('keydown',e=>{if(['ArrowUp','KeyW'].includes(e.code)&&dy===0){dx=0;dy=-1;}if(['ArrowDown','KeyS'].includes(e.code)&&dy===0){dx=0;dy=1;}if(['ArrowLeft','KeyA'].includes(e.code)&&dx===0){dx=-1;dy=0;}if(['ArrowRight','KeyD'].includes(e.code)&&dx===0){dx=1;dy=0;}});</script></body></html>"
